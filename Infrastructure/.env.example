# Template for Infrastructure/.env -- copy it, then adjust per machine:
#   cp .env.example .env          (bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# Compose auto-loads .env from this directory, but the documented commands name
# it anyway, so a missing file fails loudly instead of silently falling back to
# Docker-managed volumes:
#   docker compose --env-file Infrastructure/.env -f Infrastructure/docker-compose.yml up -d
# docker-compose.yml carries fallbacks for every value, so the stack also starts
# without this file -- but then the volumes are Docker-managed, NOT Mounts/.
# Keep this template in sync when adding vars.

# --- PostgreSQL ---
# POSTGRES_DB / USER / PASSWORD are only applied when the data volume is first
# created; changing them later has no effect until the volume is removed.
POSTGRES_DB=efindepth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port mapped to the container's 5432. Change if 5432 is already taken.
POSTGRES_PORT=5432

# --- pgAdmin ---
# Login for the pgAdmin UI at http://localhost:${PGADMIN_PORT}
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Network ---
NETWORK_NAME=efindepth-net

# --- Volumes (host bind-mount paths, relative to this directory) ---
# Container data lives in Mounts/ at the repo root (hence ../) instead of in
# Docker-managed volumes. Deleting a directory there wipes that container's
# state; Docker recreates a missing one on the next `up`, owned by root.
POSTGRES_DATA_PATH=../Mounts/postgres-data
PGADMIN_DATA_PATH=../Mounts/pgadmin-data
